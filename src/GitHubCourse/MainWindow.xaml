<Window x:Class="GitHubCourse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub — полный курс"
        Width="1440" Height="920" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="310" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#111C2E">
      <Grid Margin="21,22,18,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
          <Border Width="42" Height="42" CornerRadius="13" Background="#4F7DF3" VerticalAlignment="Center">
            <TextBlock Text="GH" Foreground="White" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="GITHUB КУРС" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="Путь от нуля до уверенности" Foreground="#9BAAC0" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Height="39" Margin="0,22,0,18">
          <TextBox x:Name="SearchBox" Padding="12,7" Background="#1B2940" Foreground="#E7EDF7"
                   BorderBrush="#2B3B55" BorderThickness="1" FontSize="12"
                   ToolTip="Поиск по названиям и разделам уроков"
                   TextChanged="SearchBox_OnTextChanged" />
          <TextBlock x:Name="SearchPlaceholder" Text="Найти урок или раздел…" Foreground="#8293AB"
                     FontSize="12" Margin="13,0,0,0" VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Grid>

        <Border Grid.Row="2" Background="#1B2940" CornerRadius="12" Padding="13,12" Margin="0,0,0,22">
          <StackPanel>
            <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="ВАШ ПРОГРЕСС" Foreground="#A8B7CB" FontSize="10" FontWeight="Bold" />
              <TextBlock x:Name="SidebarProgressText" Grid.Column="1" Text="0 из 0 уроков"
                         Foreground="White" FontSize="11" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar x:Name="CourseProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                         Foreground="#5B8CFF" Background="#31425C" BorderThickness="0" />
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="СОДЕРЖАНИЕ КУРСА" Foreground="#71839D"
                   FontSize="10" FontWeight="Bold" Margin="2,0,0,10" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="LessonNavigation" />
        </ScrollViewer>

        <StackPanel Grid.Row="5" Margin="0,14,0,0">
          <Border Height="1" Background="#29384E" Margin="0,0,0,11" />
          <TextBlock Text="ОФЛАЙН · ПРОГРЕСС ХРАНИТСЯ НА ЭТОМ ПК"
                     Foreground="#71839D" FontSize="9" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
        <Grid Margin="29,0,32,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="HeaderCourseTitle" Text="Полный курс по GitHub"
                       Foreground="#1B2638" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="HeaderCourseSubtitle" Text="Практический интерактивный учебник для Windows"
                       Foreground="#7A8798" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Background="#F1F5FD" CornerRadius="9" Padding="12,7"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderProgressText" Text="0% пройдено" Foreground="#385A9C"
                       FontWeight="SemiBold" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer x:Name="LessonScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="LessonContent" MaxWidth="930" HorizontalAlignment="Stretch"
                    Margin="42,30,42,38" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
